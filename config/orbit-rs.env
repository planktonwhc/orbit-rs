# ============================================================================
#  orbit-kms configuration reference
# ----------------------------------------------------------------------------
#  Every setting below is read from the ENVIRONMENT of the orbit-kms process.
#  Format is plain KEY=value (systemd EnvironmentFile compatible: no `export`,
#  no shell expansion, no quotes needed).
#
#  All lines are commented out and show the built-in default, so sourcing this
#  file as-is changes nothing. Uncomment and edit what you need.
#
#  How it reaches orbit-kms:
#    - systemd:   EnvironmentFile=/etc/orbit-rs/orbit-rs.env  in the unit
#    - shell:     set -a; . orbit-rs.env; set +a; goggles_capture stdout | orbit-kms
#    - ad-hoc:    env DJI_KMS_VSYNC=1 orbit-kms
#
#  Codec is picked by CLI flag, not env:
#    orbit-kms --h264            (default)
#    orbit-kms --h265            (alias --hevc; also flips DECODER default to "hevc")
# ============================================================================


# --- Display / DRM ----------------------------------------------------------

# Which HDMI output to drive. "auto" = first connected connector with modes.
# Otherwise the exact name "<TypeName>-<type_id>", e.g. HDMI-A-1, HDMI-A-2.
# The KMS card node (/dev/dri/card0|card1) is auto-probed; the mode is forced
# to 1920x1080 when the panel offers it, else connector mode 0.
# DJI_KMS_CONNECTOR=auto

# Render node for GBM/EGL, and the DRM hwdevice for HEVC hardware decode.
#DJI_KMS_DRM_DEVICE=/dev/dri/renderD128


# --- Decoder --------------------------------------------------------------

# libavcodec decoder name.
#   Pi 4 H.264 HW ...... h264_v4l2m2m   (default)
#   Pi 4 H.265 HW ...... hevc_v4l2m2m   (or leave unset with --h265 -> "hevc")
#   software fallback .. h264  /  hevc  (needed on Pi 5 for H.264)
#DJI_KMS_DECODER=h264_v4l2m2m


# --- Latency / presentation --------------------------------------------------

# Max age (ms) of a just-dequeued frame before it is dropped instead of shown.
# Safety net for when the renderer briefly falls behind. Lower = more eager to
# drop stale frames; ~1-2 frame times is sensible.
# DJI_KMS_HIDE_MS=35

# Present pacing.
#   0 (default) : flip immediately  -> lowest latency, may tear on fast pans
#   1 / y       : wait one vblank (drmWaitVBlank) before the flip -> no tearing,
#                 adds up to ~1 refresh (~8 ms avg @60Hz) and couples present to
#                 frame intake
# DJI_KMS_VSYNC=1


# --- Geometry: flip / crop / stretch --------------------------------------

# Mirror the picture. Value is any combo of the letters h and v.
#   unset            -> "v"  (GLES samples bottom-up; the decoded frame is
#                             top-down, so vertical flip is the correct default)
#   h, v, hv         -> flip horizontal / vertical / both
#   none | 0 | empty -> NO flip at all (use this to cancel the default)
#DJI_KMS_FLIP=v

# Center-crop the picture to a target on-screen aspect, then letter/pillar-box
# to that aspect. Accepts  W:H  or  W/H  (e.g. 16:9, 4:3, 9:16, 6:9), or
# off | none | 0 to disable.
# NOTE: this compares the *decoded frame* aspect to the target. The goggles
# feed is 1920x1080 (16:9) even in 4:3 air-unit modes (the 4:3 image is
# pillar-boxed *inside* the frame), so DJI_KMS_CROP=16:9 is a no-op on it.
# It only bites for a portrait target (9:16) or a genuinely non-16:9 frame.
#DJI_KMS_CROP=off

# 1 = stretch to fill the whole screen, ignoring aspect ratio (no bars).
#DJI_KMS_STRETCH=0


# --- Lens dewarp (GPU) ----------------------------------------------------
# Radial distortion correction:  f = 1 + K1*r^2 + K2*r^4 + K3*r^6
# Everything here is inert unless DJI_KMS_DEWARP=1.

# DJI_KMS_DEWARP=1
# DJI_KMS_DEWARP_K1=-0.37     # r^2 term  (barrel distortion is negative)
# DJI_KMS_DEWARP_K2=0.0       # r^4 term
# DJI_KMS_DEWARP_K3=0.0       # r^6 term
# DJI_KMS_DEWARP_CX=0.5       # distortion center X, 0..1
# DJI_KMS_DEWARP_CY=0.5       # distortion center Y, 0..1
# DJI_KMS_DEWARP_STRENGTH=1.0 # blend 0..1 between "no correction" and full
# DJI_KMS_DEWARP_ZOOM=1.0     # scale after dewarp; >1 zooms in and hides the
# DJI_KMS_DEWARP_VSCALE=1.0   # vertical weighting inside the dewarp field

# File polled every ~100 ms for live tuning while running. Lines are "key value":
#   enabled|dewarp 0|1 , k1 , k2 , k3 , cx , cy , strength , zoom , vscale
# A change to this file overrides the values above at runtime.
#DJI_KMS_DEWARP_FILE=/run/dji-fpv/dewarp


# --- Color grading (GPU) ------------------------------------------------
# Inert unless DJI_KMS_CG_ENABLE=1.

#DJI_KMS_CG_ENABLE=0
#DJI_KMS_CG_BRIGHT=0.0       # added to RGB      (~ -0.5 .. 0.5)
#DJI_KMS_CG_CONTRAST=1.0     # multiply around mid-grey (1.0 = unchanged)
#DJI_KMS_CG_SAT=1.0          # 0 = greyscale, 1 = normal, >1 = punchy
#DJI_KMS_CG_TEMP=0.0         # warm/cool: adds (+t, 0, -t); >0 warmer


# --- Waiting screen / content gate -------------------------------------------
# Shown when there is no live feed (boot, goggles unplugged, aircraft off) and
# whenever the feed stalls, instead of a black screen or a frozen last frame.
#
# DJI_KMS_STANDBY accepts:
#   - a still image  : .png .jpg .jpeg .bmp .webp
#   - a looping clip : .mp4 .mov .mkv .webm  (or a raw .h264 / .h265 stream)
# Setting DJI_KMS_STANDBY alone is enough: the gate turns on with a ~600 ms
# default. DJI_KMS_GATE_MAX_MS overrides that delay; DJI_KMS_GATE_MS only adds
# an informational "armed" log line.

#DJI_KMS_STANDBY=/data/standby.mp4   # waiting screen (still image or looped video)
#DJI_KMS_STANDBY_FPS=0               # >0 forces the loop's playback fps; 0 = the file's own
#DJI_KMS_GATE_MAX_MS=0               # ms with no live frame before standby shows (0 => 600 when STANDBY set)
#DJI_KMS_GATE_MS=0                   # ms before a soft "gate: armed" log line (0 = off)


# ============================================================================
#  Example: portrait FPV on a phone-style goggles panel, lens dewarp on
# ============================================================================
DJI_KMS_CONNECTOR=auto 
DJI_KMS_VSYNC=0
DJI_KMS_FLIP=v
DJI_KMS_CROP=16:9
DJI_KMS_STRETCH=0
DJI_KMS_HIDE_MS=35
DJI_KMS_DEWARP=1
DJI_KMS_DEWARP_K1=-0.37
DJI_KMS_DEWARP_K2=-0.12
DJI_KMS_DEWARP_K3=0.0
DJI_KMS_DEWARP_ZOOM=1.10

DJI_KMS_STANDBY=/data/orbit/media/waiting.jpg

